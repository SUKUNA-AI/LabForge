# LabForge gitignore

# -----------------------------------------------------------------------------
# Documentation policy
# Keep README files, ignore local notes/plans/spec drafts by default.
# -----------------------------------------------------------------------------
*.md
!README.md
!**/README.md

# -----------------------------------------------------------------------------
# Secrets and local configuration
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
!.env.sample
*.local
*.secret
*.secrets
secrets/
secret/
private/
credentials/
credentials.*
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
*.pgpass
.pgpass
.netrc
.pypirc
.npmrc
.docker/config.json

# API keys / model provider local files
openai_api_key*
deepseek_api_key*
langsmith_api_key*
*_api_key.txt
*_token.txt

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/
build/
dist/
sdist/
wheels/
share/python-wheels/
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments and local Python installs
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
__pypackages__/
.pdm-python
.pdm-build/
.pixi/

# Python tools and caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
cover/
*.cover
*.py.cover
.cache/
.dmypy.json
dmypy.json

# Jupyter / notebooks
.ipynb_checkpoints/
profile_default/
ipython_config.py

# -----------------------------------------------------------------------------
# FastAPI / runtime logs
# -----------------------------------------------------------------------------
*.log
logs/
*.pid
uvicorn*.pid
gunicorn*.pid
celerybeat-schedule
celerybeat.pid

# -----------------------------------------------------------------------------
# Databases, dumps, and local state
# -----------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.dump
*.sql
*.backup
*.bak
pgdata/
postgres-data/
postgres_data/
data/postgres/
tmp/
temp/

# Keep Alembic migrations tracked.
!migrations/
!migrations/**
migrations/**/__pycache__/
migrations/**/*.py[cod]

# -----------------------------------------------------------------------------
# C++ / C / CMake
# -----------------------------------------------------------------------------
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
DartConfiguration.tcl
Testing/
install_manifest.txt
compile_commands.json

# Generated build directories. Source directories named cmake/ are still tracked.
**/build/
**/out/
**/.vs/

# C/C++ compiler outputs
*.o
*.obj
*.lo
*.la
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.i
*.ii
*.s
*.d
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata

# Ninja / Make generated files
.ninja_deps
.ninja_log
*.ninja

# Conan / vcpkg local artifacts
.conan/
conanbuildinfo.*
conaninfo.txt
graph_info.json
vcpkg_installed/

# -----------------------------------------------------------------------------
# Frontend / Node, for future UI or generated docs tooling
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.next/
.nuxt/
.svelte-kit/
vite.svg

# -----------------------------------------------------------------------------
# IDEs, editors, and OS files
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# JetBrains/DataGrip local files
*.iws
dataSources/
dataSources.local.xml

# -----------------------------------------------------------------------------
# Codex / local agent workspace metadata
# -----------------------------------------------------------------------------
.codex/
.agents/

# -----------------------------------------------------------------------------
# Misc generated artifacts
# -----------------------------------------------------------------------------
.abstra/
.scrapy/
/site/
docs/_build/
marimo/_static/
marimo/_lsp/
__marimo__/
.streamlit/secrets.toml
