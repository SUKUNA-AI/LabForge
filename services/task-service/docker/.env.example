# Local host development.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/labforge_task_service
SQL_ECHO=false

# Docker Compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=labforge_task_service
POSTGRES_PORT=5433
TASK_SERVICE_PORT=8000
RUN_MIGRATIONS_ON_STARTUP=true
